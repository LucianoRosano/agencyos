{
  "name": "agencyos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @agencyos/web dev",
    "dev:worker": "pnpm --filter @agencyos/worker dev",
    "build": "pnpm --filter @agencyos/web build",
    "start": "pnpm --filter @agencyos/web start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "pnpm --filter @agencyos/db generate",
    "db:migrate": "pnpm --filter @agencyos/db migrate",
    "db:seed": "pnpm --filter @agencyos/db seed",
    "admin": "pnpm --filter @agencyos/modules admin"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^22",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  }
}
