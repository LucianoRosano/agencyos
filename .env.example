# ─────────────────────────────────────────────────────────────────────────────
# AGENCYOS · variables de entorno (plantilla SIN valores reales)
#
# Desarrollo local: copiá este archivo a apps/web/.env.local y completá.
# VPS: NO se edita a mano desde cero. infra/scripts/first-setup.sh genera
#      infra/.env (compose), infra/.env.prod e infra/.env.staging con secretos
#      aleatorios y permisos 600. Copia de los secretos críticos en Bitwarden.
# Nunca commitees un .env con valores reales (gitleaks lo bloquea en la CI).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────────────────
# Cadena de conexión a PostgreSQL (≥ 17 en producción; 16+ en desarrollo).
# Local: postgres://agencyos:agencyos@127.0.0.1:5432/agencyos
# VPS:   postgres://agencyos:<clave>@postgres:5432/agencyos  (staging: @postgres-stg)
DATABASE_URL=
# Conexiones máximas del pool por proceso (web y worker tienen el suyo). Por defecto 10.
DB_POOL_MAX=10
# Solo en el VPS: usuario, clave y base que crea el contenedor de Postgres (deben coincidir con DATABASE_URL).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── App ──────────────────────────────────────────────────────────────────────
# URL pública con la que se abre la app (sin barra final). Define cookies Secure y orígenes confiables.
# Local: http://localhost:3000 · Producción: https://<dominio> · Staging: https://staging.<dominio>
APP_URL=
# Secreto de sesiones de Better Auth. Mínimo 32 caracteres aleatorios: openssl rand -hex 32
# Si cambia, se cierran todas las sesiones. Obligatorio en producción.
AUTH_SECRET=
# Verificación de contraseñas filtradas (Have I Been Pwned, k-anonymity). "off" solo en tests.
AUTH_HIBP=on
# Rate limiting de login/2FA/recuperación. "off" solo en tests.
AUTH_RATE_LIMIT=on
# Clave maestra (32 bytes en hex = 64 caracteres) para cifrar tokens de integraciones (AES-256-GCM).
# openssl rand -hex 32 · Guardala en Bitwarden: sin ella no se pueden descifrar los tokens guardados.
# Rotación: docs/runbooks/rotar-secretos.md
APP_ENCRYPTION_KEY=
# Token de un solo uso para crear la cuenta del dueño en /setup. En producción /setup lo EXIGE.
# openssl rand -hex 16 · Después de crear la cuenta podés borrarlo.
SETUP_TOKEN=
# Versión que muestra /api/health y Configuración → Estado. En el VPS la pone deploy.sh (sha o vX.Y.Z).
APP_VERSION=
# Dominio base (solo infra/.env del VPS): Caddy sirve APP_DOMAIN y staging.APP_DOMAIN con HTTPS automático.
APP_DOMAIN=

# ── Email (Brevo) ────────────────────────────────────────────────────────────
# API key transaccional de Brevo (Settings → SMTP & API → API Keys). Sin ella no se envían mails
# (en desarrollo se imprimen en la consola) y "Recuperar contraseña" queda deshabilitado.
BREVO_API_KEY=
# Remitente verificado en Brevo (ej.: hola@<dominio>) y nombre visible.
EMAIL_FROM=
EMAIL_FROM_NAME=AGENCYOS

# ── PDFs y archivos ──────────────────────────────────────────────────────────
# Ejecutable de Chromium para generar PDFs (playwright-core). En las imágenes Docker ya viene
# configurado (/usr/local/bin/chromium). Local: vacío = el de Playwright; o la ruta de tu Chromium.
CHROMIUM_PATH=
# Carpeta donde se guardan los archivos subidos (StorageAdapter local). Docker: /data/files (volumen).
FILES_DIR=./data/files

# ── Push (opcional) ──────────────────────────────────────────────────────────
# Claves VAPID para Web Push desde la PWA: npx web-push generate-vapid-keys
# Si quedan vacías, las notificaciones push no se ofrecen.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del emisor de push (mailto:…).
VAPID_SUBJECT=mailto:lucianorosanott@gmail.com

# ── GitHub (Repositorios, docs/15 y docs/runbooks/github-app.md) ─────────────
# Credenciales de la GitHub App "AGENCYOS". Se obtienen UNA vez con el botón "Crear la GitHub App"
# (Repositorios), que las muestra después del flujo de manifest; NO se guardan en la base.
# Sin estas variables, Repositorios muestra el paso a paso para crear la App.
# ID numérico de la App.
GITHUB_APP_ID=
# Clave privada PEM de la App. En una sola línea con \n literales (o entre comillas, multilínea).
GITHUB_APP_PRIVATE_KEY=
# Secreto para verificar la firma (X-Hub-Signature-256) de los webhooks en /api/webhooks/github.
GITHUB_WEBHOOK_SECRET=
# Nombre corto (slug) de la App: arma el enlace de instalación https://github.com/apps/<slug>.
GITHUB_APP_SLUG=
# SOLO tests/e2e: "1" usa un GitHub simulado en memoria con fixtures. Ignorado con NODE_ENV=production.
GITHUB_FAKE=
