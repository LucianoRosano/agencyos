{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.next",
      "!**/node_modules",
      "!**/dist",
      "!**/migrations/meta",
      "!docs",
      "!**/*.md",
      "!**/test-results",
      "!**/playwright-report",
      "!**/blob-report",
      "!**/coverage",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        // Los controles propios (TaskCheck, selector "Para quién") son <button> con role="checkbox"/"radio" + aria-checked:
        // patrón ARIA válido que conserva el foco/teclado del botón y zonas táctiles de 44 px. Los e2e corren axe sobre ellos.
        "useSemanticElements": "off",
        // autoFocus se usa solo en diálogos/hojas de captura rápida (abiertos por el usuario), donde mover el foco es lo esperado.
        "noAutofocus": "off",
        // <Checkbox> de @agencyos/ui renderiza un control real dentro de <label>.
        "noLabelWithoutControl": { "level": "error", "options": { "inputComponents": ["Checkbox", "Input", "Select", "Textarea"] } }
      },
      "complexity": {
        // Falso positivo con fechas "YYYY-MM-DD" (strings): Math.min/max no aplica a strings.
        "useMathMinMax": "off"
      }
    }
  },
  "overrides": [
    {
      // prefers-reduced-motion necesita !important para anular animaciones de cualquier especificidad.
      "includes": ["**/*.css"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
    }
  ]
}
